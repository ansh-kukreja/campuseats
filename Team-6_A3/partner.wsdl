<?xml version="1.0" encoding="UTF-8"?>
<definitions name="PaymentsService"
             targetNamespace="urn:unipay:payments"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="urn:unipay:payments">

  <types>
    <xsd:schema targetNamespace="urn:unipay:payments">

      <xsd:element name="charge">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="cardToken" type="xsd:string"/>
            <xsd:element name="amount" type="xsd:decimal"/>
            <xsd:element name="currency" type="xsd:string"/>
            <xsd:element name="orderRef" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="chargeResult">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="transactionId" type="xsd:string"/>
            <xsd:element name="status" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="chargeFault">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="code" type="xsd:string"/>
            <xsd:element name="reason" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </types>

  <message name="chargeRequest">
    <part name="body" element="tns:charge"/>
  </message>

  <message name="chargeResponse">
    <part name="body" element="tns:chargeResult"/>
  </message>

  <message name="chargeFaultMessage">
    <part name="fault" element="tns:chargeFault"/>
  </message>

  <portType name="Payments">
    <operation name="charge">
      <input message="tns:chargeRequest"/>
      <output message="tns:chargeResponse"/>
      <fault name="ChargeFault" message="tns:chargeFaultMessage"/>
    </operation>
  </portType>

  <binding name="PaymentsSOAP" type="tns:Payments">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
    <operation name="charge">
      <soap:operation soapAction="urn:unipay:charge"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
      <fault name="ChargeFault">
        <soap:fault name="ChargeFault" use="literal"/>
      </fault>
    </operation>
  </binding>

  <service name="PaymentsService">
    <port name="PaymentsSOAP" binding="tns:PaymentsSOAP">
      <soap:address location="https://api.unipay.example/pay"/>
    </port>
  </service>

</definitions>
